# Copy to .env and fill in. NEVER commit the real .env.
# Gemini API key — used by build/gen_scene_images.mjs (scene image generation)
# and Gemini-based transcription. Free tier = 20 req/day; enable billing for reliability.
GKEY=your-gemini-api-key-here

